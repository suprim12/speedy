{% import '_includes/forms' as forms %}

{% macro configWarning(setting) -%}
	{{ 'This is being overridden by the {setting} setting in config/speedy.php.'|t('speedy', { setting: '<code>' ~ setting ~ '</code>' })|raw }}
{%- endmacro %}
{% from _self import configWarning %}

{% set warmIsList = settings.warm is iterable %}

<div id="general">
{# Status ------------------------------------------------------------------- #}
<div class="speedy-status">
	<div class="speedy-status__item">
		<span class="status {{ settings.isEnabled() ? 'green' : 'disabled' }}" aria-hidden="true"></span>
		<span><strong>{{ settings.isEnabled() ? 'Caching on'|t('speedy') : 'Caching off'|t('speedy') }}</strong>
		{% if ephemeral %}<span class="light">{{ 'This host’s disk is temporary, as on Craft Cloud, which caches pages itself.'|t('speedy') }}</span>{% endif %}
		<span class="light">{{ '{count, plural, =1{# page} other{# pages}} cached'|t('speedy', { count: stats.pages }) }}</span></span>
	</div>
	<div class="speedy-status__item">
		<span class="status {{ configured|length ? 'green' : (detected ? 'orange' : 'disabled') }}" aria-hidden="true"></span>
		<span><strong>{{ detected ? cdnNames[detected] : 'No CDN seen'|t('speedy') }}</strong>
		<span class="light">{{ configured|length ? 'Cleared automatically'|t('speedy') : (detected ? 'Add its details below'|t('speedy') : 'Optional'|t('speedy')) }}</span></span>
	</div>
	<a class="btn small" href="{{ url('utilities/speedy') }}">{{ 'Open Speedy Cache utility'|t('speedy') }}</a>
</div>

{# Caching ------------------------------------------------------------------ #}
{{ forms.lightswitchField({
	label: 'Cache pages'|t('speedy'),
	instructions: 'Turn this off to stop caching, such as on dev.'|t('speedy'),
	name: 'enabled',
	on: settings.isEnabled(),
	disabled: 'enabled' in overrides,
	warning: 'enabled' in overrides ? configWarning('enabled'),
}) }}

<div class="flex-fields">
	{{ forms.textareaField({
		label: 'Never cache'|t('speedy'),
		instructions: 'One URL path per line. `*` matches anything.'|t('speedy'),
		fieldClass: 'width-50',
		name: 'neverCache',
		value: settings.getNeverCache()|join("\n"),
		placeholder: "checkout/*\naccount*\nsearch",
		rows: 4,
		class: 'code',
		disabled: 'neverCache' in overrides,
		warning: 'neverCache' in overrides ? configWarning('neverCache'),
	}) }}
	{{ forms.textareaField({
		label: 'Only cache'|t('speedy'),
		instructions: 'Leave empty to cache every page. `/` is the homepage.'|t('speedy'),
		fieldClass: 'width-50',
		name: 'onlyCache',
		value: settings.getOnlyCache()|join("\n"),
		placeholder: "/\nnews*\nabout",
		rows: 4,
		class: 'code',
		disabled: 'onlyCache' in overrides,
		warning: 'onlyCache' in overrides ? configWarning('onlyCache'),
	}) }}
	{{ forms.selectField({
		label: 'When content changes'|t('speedy'),
		instructions: 'Rebuilding keeps the old copy until the new one is ready, so nobody waits.'|t('speedy'),
		fieldClass: 'width-50',
		name: 'rebuildCleared',
		options: [
			{ label: 'Rebuild the changed pages in the background'|t('speedy'), value: '1' },
			{ label: 'Remove them; the next visitor rebuilds them'|t('speedy'), value: '' },
		],
		value: settings.rebuildCleared ? '1' : '',
		disabled: 'rebuildCleared' in overrides,
		warning: 'rebuildCleared' in overrides ? configWarning('rebuildCleared'),
	}) }}
	{{ forms.selectField({
		label: 'After clearing everything'|t('speedy'),
		instructions: 'Such as after a deploy.'|t('speedy'),
		fieldClass: 'width-50',
		name: 'warm',
		options: [
			{ label: 'Rebuild every page in the sitemap'|t('speedy'), value: 'sitemap' },
			{ label: 'Wait for visitors'|t('speedy'), value: '' },
		]|merge(warmIsList ? [{ label: 'Rebuild the pages listed in config/speedy.php'|t('speedy'), value: 'list' }] : []),
		value: warmIsList ? 'list' : (settings.warm == 'sitemap' ? 'sitemap' : ''),
		disabled: 'warm' in overrides,
		warning: 'warm' in overrides ? configWarning('warm'),
	}) }}
</div>

</div>

{# CDN ---------------------------------------------------------------------- #}
<div id="cdn" class="hidden">
<p class="speedy-intro">{{ 'Optional. Set the details for the CDN or proxy in front of your site: it then keeps pages too, and Speedy clears them when content changes. Without them, it’s told not to keep pages, so it never shows old ones. Use environment variables, such as $CLOUDFLARE_TOKEN.'|t('speedy') }}</p>

<div class="speedy-cdns">
	{% for cdn in ['cloudflare', 'cloudfront', 'fastly', 'bunny', 'varnish'] %}
		<div class="speedy-cdn {{ detected == cdn ? 'speedy-cdn--seen' }}">
			<div class="speedy-cdn__about">
				<h3>{{ cdnNames[cdn] }}</h3>
				{% if cdn in configured %}
					<span class="speedy-pill speedy-pill--on">{{ 'Set up'|t('speedy') }}</span>
				{% elseif detected == cdn %}
					<span class="speedy-pill speedy-pill--seen">{{ 'Your site is behind it'|t('speedy') }}</span>
				{% endif %}
				{% if cdnLast[cdn] is defined %}
					<p class="{{ cdnLast[cdn].error ? 'error' : 'light' }} smalltext">{{ cdnLast[cdn].result }} · {{ cdnLast[cdn].time|datetime('short') }}</p>
				{% endif %}
				<p class="smalltext"><a href="https://plugins.speedy.suprim.com.au/guides/{{ cdn in ['cloudflare', 'cloudfront'] ? cdn : 'other-cdns' }}" target="_blank" rel="noopener">{{ 'Setup guide'|t('speedy') }}</a></p>
			</div>
			<div class="speedy-cdn__fields">

			{% if cdn == 'cloudflare' %}
				{{ forms.autosuggestField({
					label: 'API token'|t('speedy'),
					instructions: 'With only the Zone → Cache Purge permission.'|t('speedy'),
					name: 'cloudflareToken',
					value: settings.cloudflareToken,
					suggestEnvVars: true,
					tip: '',
					disabled: 'cloudflareToken' in overrides,
					warning: 'cloudflareToken' in overrides ? configWarning('cloudflareToken'),
				}) }}
				{{ forms.autosuggestField({
					label: 'Zone ID'|t('speedy'),
					instructions: settings.getCloudflareZoneDomains() ? 'For domains not in `cloudflareZones` in config/speedy.php: {domains}.'|t('speedy', { domains: settings.getCloudflareZoneDomains()|join(', ') }) : 'On the domain’s overview page. For a zone per domain, use `cloudflareZones` in config/speedy.php.'|t('speedy'),
					name: 'cloudflareZoneId',
					value: settings.cloudflareZoneId,
					suggestEnvVars: true,
					tip: '',
					disabled: 'cloudflareZoneId' in overrides,
					warning: 'cloudflareZoneId' in overrides ? configWarning('cloudflareZoneId'),
				}) }}
			{% elseif cdn == 'fastly' %}
				{{ forms.autosuggestField({
					label: 'API token'|t('speedy'),
					instructions: 'A token with purge permission for the service.'|t('speedy'),
					name: 'fastlyToken',
					value: settings.fastlyToken,
					suggestEnvVars: true,
					tip: '',
					disabled: 'fastlyToken' in overrides,
					warning: 'fastlyToken' in overrides ? configWarning('fastlyToken'),
				}) }}
				{{ forms.autosuggestField({
					label: 'Service ID'|t('speedy'),
					name: 'fastlyServiceId',
					value: settings.fastlyServiceId,
					suggestEnvVars: true,
					tip: '',
					disabled: 'fastlyServiceId' in overrides,
					warning: 'fastlyServiceId' in overrides ? configWarning('fastlyServiceId'),
				}) }}
			{% elseif cdn == 'bunny' %}
				{{ forms.autosuggestField({
					label: 'API key'|t('speedy'),
					instructions: 'Account → API in the Bunny dashboard.'|t('speedy'),
					name: 'bunnyApiKey',
					value: settings.bunnyApiKey,
					suggestEnvVars: true,
					tip: '',
					disabled: 'bunnyApiKey' in overrides,
					warning: 'bunnyApiKey' in overrides ? configWarning('bunnyApiKey'),
				}) }}
				{{ forms.autosuggestField({
					label: 'Pull zone ID'|t('speedy'),
					name: 'bunnyPullZoneId',
					value: settings.bunnyPullZoneId,
					suggestEnvVars: true,
					tip: '',
					disabled: 'bunnyPullZoneId' in overrides,
					warning: 'bunnyPullZoneId' in overrides ? configWarning('bunnyPullZoneId'),
				}) }}
			{% elseif cdn == 'varnish' %}
				{{ forms.textareaField({
					label: 'Varnish servers'|t('speedy'),
					instructions: 'One per line, such as http://127.0.0.1:6081. Speedy sends PURGE and BAN requests; allow them in the VCL.'|t('speedy'),
					name: 'varnishUrls',
					value: settings.getVarnishUrls()|join("\n"),
					rows: 2,
					class: 'code',
					disabled: 'varnishUrls' in overrides,
					warning: 'varnishUrls' in overrides ? configWarning('varnishUrls'),
				}) }}
			{% else %}
				{{ forms.autosuggestField({
					label: 'Distribution ID'|t('speedy'),
					name: 'cloudfrontDistributionId',
					value: settings.cloudfrontDistributionId,
					suggestEnvVars: true,
					tip: '',
					disabled: 'cloudfrontDistributionId' in overrides,
					warning: 'cloudfrontDistributionId' in overrides ? configWarning('cloudfrontDistributionId'),
				}) }}
				{{ forms.autosuggestField({
					label: 'Access key ID'|t('speedy'),
					instructions: 'Allowed only cloudfront:CreateInvalidation. Blank uses AWS_ACCESS_KEY_ID.'|t('speedy'),
					name: 'awsAccessKeyId',
					value: settings.awsAccessKeyId,
					suggestEnvVars: true,
					tip: '',
					disabled: 'awsAccessKeyId' in overrides,
					warning: 'awsAccessKeyId' in overrides ? configWarning('awsAccessKeyId'),
				}) }}
				{{ forms.autosuggestField({
					label: 'Secret access key'|t('speedy'),
					instructions: 'Blank uses AWS_SECRET_ACCESS_KEY.'|t('speedy'),
					name: 'awsSecretAccessKey',
					value: settings.awsSecretAccessKey,
					suggestEnvVars: true,
					tip: '',
					disabled: 'awsSecretAccessKey' in overrides,
					warning: 'awsSecretAccessKey' in overrides ? configWarning('awsSecretAccessKey'),
				}) }}
			{% endif %}
			</div>
		</div>
	{% endfor %}
</div>

</div>

{# Advanced ----------------------------------------------------------------- #}
<div id="advanced" class="hidden">
{{ forms.selectField({
	label: 'Cache storage'|t('speedy'),
	instructions: 'Where cached pages are stored. File storage is the fastest, and lets the web server serve pages directly without PHP. Craft cache (Redis or Memcached) shares pages across multiple web servers without shared disk storage; pages are then served through PHP.'|t('speedy'),
	id: 'storage',
	name: 'storage',
	options: [
		{ label: 'File storage (recommended)'|t('speedy'), value: 'files' },
		{ label: 'Craft cache — {backend}'|t('speedy', { backend: cacheInfo.label }), value: 'craftCache' },
	],
	value: settings.storage,
	disabled: 'storage' in overrides,
	warning: 'storage' in overrides ? configWarning('storage') : (cacheInfo.database ? 'Craft’s cache uses the database on this site. Storing pages there would grow the database; configure Redis or use file storage.'|t('speedy') : (not cacheInfo.shared ? 'Craft’s cache is local to this server, so it isn’t shared across web servers.'|t('speedy'))),
}) }}

<hr>
{{ forms.autosuggestField({
	label: 'API key'|t('speedy'),
	instructions: 'Lets a deploy pipeline or another system clear and rebuild pages over HTTP. At least 16 characters; best kept in .env, such as $SPEEDY_API_KEY. Send it in an `Authorization: Bearer` header or as a `key` field in the POST body, never in the URL. Leave blank to turn the API off.'|t('speedy'),
	id: 'apiKey',
	name: 'apiKey',
	value: settings.apiKey,
	suggestEnvVars: true,
	errors: settings.getErrors('apiKey'),
	disabled: 'apiKey' in overrides,
	warning: 'apiKey' in overrides ? configWarning('apiKey'),
}) }}
{% if 'apiKey' not in overrides %}
	<p class="speedy-under"><a href="#" class="speedy-generate">{{ 'Generate a key'|t('speedy') }}</a></p>
{% endif %}
{% if settings.getApiKey() %}
	<div class="field">
		<div class="heading"><label>{{ 'Example'|t('speedy') }}</label></div>
		<div class="instructions"><p>{{ 'Clears every page. See the docs for clearing some pages or rebuilding.'|t('speedy') }} <a href="https://plugins.speedy.suprim.com.au/guides/api" target="_blank" rel="noopener">{{ 'API docs'|t('speedy') }}</a></p></div>
		<pre class="speedy-code"><code>curl -X POST {{ siteUrl(craft.app.config.general.actionTrigger ~ '/speedy/api/clear') }} \
  -H "Authorization: Bearer $SPEEDY_API_KEY"</code></pre>
	</div>
{% endif %}

<hr>
<h3>{{ 'Set in config/speedy.php'|t('speedy') }}</h3>
<p class="speedy-intro">{{ 'Less common options, with the values in use now.'|t('speedy') }} <a href="https://plugins.speedy.suprim.com.au/getting-started/configuration" target="_blank" rel="noopener">{{ 'All options'|t('speedy') }}</a></p>
<table class="data fullwidth speedy-config">
	<thead><tr><th scope="col">{{ 'Option'|t('speedy') }}</th><th scope="col">{{ 'Value'|t('speedy') }}</th><th scope="col">{{ 'What it does'|t('speedy') }}</th></tr></thead>
	<tbody>
		{% for row in configRows %}
			<tr>
				<td class="nowrap"><code>{{ row.name }}</code>{% if row.name in overrides %} <span class="speedy-pill speedy-pill--seen">{{ 'set in file'|t('speedy') }}</span>{% endif %}</td>
				<td><code>{{ row.value }}</code></td>
				<td class="light">{{ row.info }}</td>
			</tr>
		{% endfor %}
	</tbody>
</table>
</div>

{% css %}
.speedy-status { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding: 14px 18px; margin-bottom: 28px; border-radius: 8px; background: var(--gray-050, #f3f7fc); }
.speedy-status__item { display: flex; align-items: baseline; gap: 8px; }
.speedy-status__item .light { margin-left: 6px; }
.speedy-status .btn { margin-left: auto; }
.speedy-config td { vertical-align: top; }
.speedy-code { background: var(--gray-050, #f3f7fc); padding: 12px 14px; border-radius: 6px; font-size: 12px; margin: 0; white-space: pre-wrap; }
.speedy-under { margin-top: -12px; margin-bottom: 24px; font-size: 13px; }
.speedy-intro { max-width: 70ch; color: var(--light-text-color, #606d7b); margin-bottom: 20px; }
.speedy-cdns { border-top: 1px solid var(--hairline-color, #e3e5e8); }
.speedy-cdn { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; padding: 24px 0 8px; border-bottom: 1px solid var(--hairline-color, #e3e5e8); }
.speedy-cdn__about h3 { margin: 0 0 6px; }
.speedy-cdn__about p { margin: 6px 0 0; }
.speedy-cdn--seen .speedy-cdn__about h3 { color: var(--blue-700, #1d4ed8); }
.speedy-cdn__fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0 24px; }
/* Inputs in a row line up, however long the help above them. */
.speedy-cdn__fields > .field { display: flex; flex-direction: column; margin: 0 0 16px !important; }
.speedy-cdn__fields > .field > .input { margin-top: auto; }
.speedy-cdn__fields > .field:only-child { grid-column: 1 / -1; max-width: 520px; }
@media (max-width: 860px) { .speedy-cdn { grid-template-columns: 1fr; gap: 12px; } }
.speedy-pill { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; }
.speedy-pill--on { background: var(--green-100, #dcfce7); color: var(--green-700, #15803d); }
.speedy-pill--seen { background: var(--blue-100, #dbeafe); color: var(--blue-700, #1d4ed8); }
{% endcss %}

{% js %}
document.querySelectorAll('.speedy-generate').forEach(function (link) {
	link.addEventListener('click', function (e) {
		e.preventDefault();
		var bytes = new Uint8Array(24);
		crypto.getRandomValues(bytes);
		var key = Array.from(bytes, function (b) { return b.toString(16).padStart(2, '0'); }).join('');
		var input = document.querySelector('input[name="settings[apiKey]"]');
		if (input) { input.value = key; input.dispatchEvent(new Event('input', { bubbles: true })); input.focus(); }
	});
});
{% endjs %}
