{% import _self as speedyMacros %}
{% import '_includes/forms' as forms %}
<div class="speedy">
	<div class="speedy-grid">
		<div class="speedy-card">
			<p class="light">{{ 'Caching'|t('speedy') }}</p>
			<p class="speedy-big">{{ settings.isEnabled() ? 'On'|t('speedy') : 'Off'|t('speedy') }}</p>
		</div>
		<div class="speedy-card">
			<p class="light">{{ 'Pages cached'|t('speedy') }}</p>
			<p class="speedy-big">{{ stats.pages|number }}</p>
			<p class="light">{{ (stats.bytes / 1048576)|number_format(1) }} MB</p>
		</div>
		{% if coverage.total %}
			<div class="speedy-card">
				<p class="light">{{ 'Coverage'|t('speedy') }}</p>
				<p class="speedy-big">{{ (coverage.cached / coverage.total * 100)|round(0, 'floor') }}%</p>
				<p class="light"><a href="#pages">{{ '{cached} of {total} content pages'|t('speedy', { cached: coverage.cached|number, total: coverage.total|number }) }}</a></p>
			</div>
		{% endif %}
		<div class="speedy-card">
			<p class="light">{{ 'CDN'|t('speedy') }}</p>
			<p class="speedy-big">{{ detected ? cdnNames[detected] : 'None seen'|t('speedy') }}</p>
			<p class="light">
				{% if configured|length %}{{ 'Clearing: {cdns}'|t('speedy', { cdns: configured|map(c => cdnNames[c])|join(', ') }) }}
				{% elseif detected %}{{ 'Add details in Settings to let it cache pages too.'|t('speedy') }}
				{% else %}{{ 'Optional'|t('speedy') }}{% endif %}
			</p>
		</div>
		{% if 'cloudfront' in configured %}
			<div class="speedy-card">
				<p class="light">{{ 'CloudFront paths this month'|t('speedy') }}</p>
				<p class="speedy-big">{{ cloudfront.paths|number }}</p>
				<p class="light">{{ 'The first 1,000 each month are free.'|t('speedy') }}</p>
			</div>
		{% endif %}
	</div>

	{% if checks|length %}
		<ul class="speedy-checks">
			{% for check in checks %}
				<li class="speedy-check speedy-check--{{ check.level }}">
					<span class="speedy-check__dot" aria-hidden="true"></span>
					<span><strong>{{ { error: 'Problem'|t('speedy'), warning: 'Check'|t('speedy'), hint: 'Tip'|t('speedy') }[check.level] }}</strong> {{ check.message|md(inlineOnly=true, encode=true) }}</span>
				</li>
			{% endfor %}
		</ul>
	{% endif %}

	{% set pageCheck = pageCheck ?? null %}
	<div class="speedy-tools">
		<div class="speedy-card speedy-tool">
			<h2 class="speedy-tool__title">{{ 'Every page'|t('speedy') }}</h2>
			<p class="light smalltext">{{ 'Rebuild keeps the old copies until the new ones are ready.'|t('speedy') }}</p>
			<div class="speedy-tool__buttons">
				<form method="post">
					{{ csrfInput() }}{{ actionInput('speedy/utility/rebuild-all') }}
					<button type="submit" class="btn submit">{{ 'Rebuild all pages'|t('speedy') }}</button>
				</form>
				<form method="post">
					{{ csrfInput() }}{{ actionInput('speedy/utility/clear-all') }}
					<button type="submit" class="btn">{{ 'Clear all pages'|t('speedy') }}</button>
				</form>
				{% if settings.warm %}
					<form method="post">
						{{ csrfInput() }}{{ actionInput('speedy/utility/warm') }}
						<button type="submit" class="btn">{{ 'Warm pages'|t('speedy') }}</button>
					</form>
				{% endif %}
			</div>
		</div>

		<div class="speedy-card speedy-tool">
			<h2 class="speedy-tool__title">{{ 'Some pages'|t('speedy') }}</h2>
			<form method="post" class="speedy-tool__row">
				{{ csrfInput() }}{{ actionInput('speedy/utility/clear-url') }}
				<input type="text" name="url" class="text" placeholder="https://… {{ 'or'|t('speedy') }} /news/*" aria-label="{{ 'URL to clear, or a pattern with *'|t('speedy') }}" title="{{ 'One page, or every page matching a pattern, such as /news/*'|t('speedy') }}" required>
				<button type="submit" class="btn">{{ 'Clear URL'|t('speedy') }}</button>
			</form>
			{% if sections ?? false %}
				{% set groupsToo = sections|filter(o => o.optgroup is defined)|length > 0 %}
				<form method="post" class="speedy-tool__row">
					{{ csrfInput() }}{{ actionInput('speedy/utility/clear-section') }}
					{{ forms.selectize({
						name: 'sectionIds',
						multi: true,
						options: sections,
						inputAttributes: { aria: { label: 'Sections to clear'|t('speedy') } },
						selectizeOptions: { placeholder: (groupsToo ? 'Choose sections or groups' : 'Choose sections')|t('speedy') },
					}) }}
					<button type="submit" class="btn" title="{{ 'Their listings and the pages that show their entries.'|t('speedy') }}">{{ 'Clear section'|t('speedy') }}</button>
				</form>
			{% endif %}
			{% if sites ?? false %}
				<form method="post" class="speedy-tool__row">
					{{ csrfInput() }}{{ actionInput('speedy/utility/clear-site') }}
					{{ forms.selectize({
						name: 'siteIds',
						multi: true,
						options: sites,
						inputAttributes: { aria: { label: 'Sites to clear'|t('speedy') } },
						selectizeOptions: { placeholder: 'Choose sites'|t('speedy') },
					}) }}
					<button type="submit" class="btn">{{ 'Clear site'|t('speedy') }}</button>
				</form>
			{% endif %}
		</div>

		<div class="speedy-card speedy-tool">
			<h2 class="speedy-tool__title">{{ 'Why isn’t this page cached?'|t('speedy') }}</h2>
			<p class="light smalltext">{{ 'Opens it as a visitor would, and says what to change.'|t('speedy') }}</p>
			<form method="post" class="speedy-tool__row">
				{{ csrfInput() }}{{ actionInput('speedy/utility/check-page') }}{{ redirectInput('utilities/speedy') }}
				<input type="text" name="url" class="text" value="{{ pageCheck.url ?? '' }}" placeholder="https://… {{ 'or'|t('speedy') }} /news" aria-label="{{ 'Page to check'|t('speedy') }}" required>
				<button type="submit" class="btn">{{ 'Check'|t('speedy') }}</button>
			</form>
		</div>
	</div>

	{% if pageCheck %}
		<div class="speedy-check speedy-check--{{ pageCheck.cached ? 'ok' : 'warning' }} speedy-pagecheck__result" role="status">
			<span class="speedy-check__dot" aria-hidden="true"></span>
			<div>
				<p><strong>{{ pageCheck.answer|md(inlineOnly=true, encode=true) }}</strong></p>
				{% if pageCheck.why %}<p>{{ pageCheck.why|md(inlineOnly=true, encode=true) }}</p>{% endif %}
				{% if pageCheck.fix %}<p><strong>{{ 'What to do:'|t('speedy') }}</strong> {{ pageCheck.fix|md(inlineOnly=true, encode=true) }}</p>{% endif %}
				{% for note in pageCheck.notes %}<p class="light">{{ note|md(inlineOnly=true, encode=true) }}</p>{% endfor %}
				{% if pageCheck.visits|length %}<p class="light smalltext">{{ pageCheck.visits|join(' · ') }}</p>{% endif %}
			</div>
		</div>
	{% endif %}

	{% set tabs = {
		pages: 'Pages'|t('speedy'),
		clears: 'Recent clears'|t('speedy'),
	}|merge(settings.queryReport ? { queries: 'Performance'|t('speedy') } : {})|merge({
		setup: 'Setup'|t('speedy'),
	}) %}
	{% set counts = { pages: stats.pages, queries: queries|length + broad|length } %}
	<nav class="speedy-tabs" role="tablist" aria-label="{{ 'Speedy Cache'|t('speedy') }}" hidden>
		{% for id, label in tabs %}
			<a href="#{{ id }}" role="tab" id="speedy-tab-{{ id }}" aria-controls="speedy-panel-{{ id }}" aria-selected="false" tabindex="-1">
				{{ label }}{% if counts[id] ?? 0 %} <span class="speedy-badge{{ id == 'queries' ? ' speedy-badge--alert' }}">{{ counts[id]|number }}</span>{% endif %}
			</a>
		{% endfor %}
	</nav>

	<section class="speedy-panel" id="speedy-panel-pages" role="tabpanel" aria-labelledby="speedy-tab-pages">
		<h2 class="speedy-panel__title">{{ 'Cached pages'|t('speedy') }}</h2>
		{% if coverage.total %}
			{% set missing = coverage.total - coverage.cached %}
			<h3>{{ 'Coverage'|t('speedy') }}</h3>
			<p>{{ 'The pages of entries, categories and other content with their own URL, and how many are cached. Pages are cached as visitors open them: build the rest now, so no visitor waits for one. A page that couldn’t be built says why, such as an error in its template (status 500).'|t('speedy') }}</p>
			<table class="data fullwidth speedy-pages speedy-coverage">
				<thead><tr>
					<th scope="col">{{ 'Section'|t('speedy') }}</th>
					<th scope="col">{{ 'Cached'|t('speedy') }}</th>
					<th scope="col">{{ 'Not cached yet'|t('speedy') }}</th>
				</tr></thead>
				<tbody>
					{% for group in coverage.groups %}
						<tr>
							<td>{{ group.label }}</td>
							<td class="nowrap">{{ '{cached} of {total}'|t('speedy', { cached: group.cached|number, total: group.total|number }) }}</td>
							<td>
								{% if group.missing|length %}
									<details><summary class="light">{{ '{count, plural, =1{# page} other{# pages}}'|t('speedy', { count: group.missing|length }) }}</summary><div class="speedy-urls">
										{% for url in group.missing|slice(0, 20) %}<div><a href="{{ url }}" target="_blank" rel="noopener">{{ url|replace({ 'https://': '', 'http://': '' }) }}</a></div>{% endfor %}
										{% if group.missing|length > 20 %}<div>{{ 'and {count} more'|t('speedy', { count: (group.missing|length - 20)|number }) }}</div>{% endif %}
									</div></details>
								{% endif %}
								{% if group.failed|length %}
									<details><summary class="light">{{ '{count, plural, =1{# page couldn’t be built} other{# pages couldn’t be built}}'|t('speedy', { count: group.failed|length }) }}</summary><div class="speedy-urls">
										{% for url, why in group.failed|slice(0, 20, true) %}<div><a href="{{ url }}" target="_blank" rel="noopener">{{ url|replace({ 'https://': '', 'http://': '' }) }}</a> · {{ why }}</div>{% endfor %}
										{% if group.failed|length > 20 %}<div>{{ 'and {count} more'|t('speedy', { count: (group.failed|length - 20)|number }) }}</div>{% endif %}
									</div></details>
								{% endif %}
								{% if not group.missing|length and not group.failed|length %}
									<span class="light">{{ 'All cached'|t('speedy') }}</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			<div class="flex speedy-coverage-actions">
				{% if missing and settings.isEnabled() %}
					<form method="post">
						{{ csrfInput() }}{{ actionInput('speedy/utility/build-missing') }}{{ redirectInput('utilities/speedy#pages') }}
						{% set untried = coverage.groups|reduce((sum, group) => sum + group.missing|length, 0) %}
						<button type="submit" class="btn">{{ untried ? 'Build the {count, plural, =1{# page} other{# pages}} not cached'|t('speedy', { count: missing }) : 'Try the {count, plural, =1{# page} other{# pages}} again'|t('speedy', { count: missing }) }}</button>
					</form>
				{% endif %}
				<span class="light smalltext">
					{{ 'Counted {time}.'|t('speedy', { time: coverage.time|datetime('short') }) }}
					{% if coverage.never %}{{ '{count, plural, =1{# page is} other{# pages are}} left out by Never cache or Only cache.'|t('speedy', { count: coverage.never }) }}{% endif %}
					{% if coverage.redirects ?? false %}{{ '{count, plural, =1{# page redirects} other{# pages redirect}} elsewhere, so there’s nothing to cache.'|t('speedy', { count: coverage.redirects }) }}{% endif %}
					{% if coverage.noTemplate ?? false %}{{ '{count, plural, =1{# page is} other{# pages are}} left out because their template doesn’t exist: {sections}.'|t('speedy', { count: coverage.noTemplate|reduce((sum, n) => sum + n, 0), sections: coverage.noTemplate|keys|join(', ') }) }}{% endif %}
					{% if coverage.capped %}{{ 'Only the first {count} pages are counted.'|t('speedy', { count: constant('suprim\\speedy\\services\\Insights::COVERAGE_MOST')|number }) }}{% endif %}
				</span>
			</div>
			<h3>{{ 'Cached pages'|t('speedy') }}</h3>
		{% endif %}
		<form method="get" class="flex speedy-search" action="{{ url('utilities/speedy') }}#pages">
			<input type="search" name="speedySearch" value="{{ search }}" class="text" placeholder="{{ 'Search URLs'|t('speedy') }}" aria-label="{{ 'Search URLs'|t('speedy') }}" style="width: 320px;">
			<button type="submit" class="btn">{{ 'Search'|t('speedy') }}</button>
			<span class="light">{{ '{count, plural, =1{# page} other{# pages}}'|t('speedy', { count: list.total }) }}</span>
		</form>
		{% if list.pages|length %}
			<table class="data fullwidth speedy-pages">
				<thead><tr>
					<th scope="col">{{ 'URL'|t('speedy') }}</th>
					<th scope="col">{{ 'Cached'|t('speedy') }}</th>
					<th scope="col">{{ 'Clears when these change'|t('speedy') }}</th>
					<th scope="col"><span class="visually-hidden">{{ 'Actions'|t('speedy') }}</span></th>
				</tr></thead>
				<tbody>
					{% for row in list.pages %}
						{% set deps = row.deps %}
						<tr>
							<td><a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url|replace({ 'https://': '', 'http://': '' }) }}</a></td>
							<td class="nowrap">
								{{ row.created ? row.created|datetime('short') }}
								{% if row.expires %}<div class="light smalltext">{{ 'Rebuilt {time}'|t('speedy', { time: row.expires|datetime('short') }) }}</div>{% endif %}
							</td>
							<td>
								{% if deps|length %}
									<details><summary class="light">{{ '{count, plural, =1{# thing} other{# things}}'|t('speedy', { count: deps|length }) }}</summary><ul class="speedy-deps">{% for dep in deps %}<li>{{ dep|raw }}</li>{% endfor %}</ul></details>
								{% else %}
									<span class="light">{{ 'Only a full clear'|t('speedy') }}</span>
								{% endif %}
							</td>
							<td class="thin">
								<form method="post">
									{{ csrfInput() }}{{ actionInput('speedy/utility/clear-url') }}{{ hiddenInput('url', row.url) }}
									<button type="submit" class="btn small">{{ 'Clear'|t('speedy') }}</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			{% set pages = (list.total / perPage)|round(0, 'ceil') %}
			{% if pages > 1 %}
				<div class="flex speedy-pager">
					{% if page > 1 %}<a class="btn small" href="{{ url('utilities/speedy', { speedySearch: search, speedyPage: page - 1 }) }}#pages">{{ 'Previous'|t('speedy') }}</a>{% endif %}
					<span class="light">{{ 'Page {page} of {pages}'|t('speedy', { page: page, pages: pages }) }}</span>
					{% if page < pages %}<a class="btn small" href="{{ url('utilities/speedy', { speedySearch: search, speedyPage: page + 1 }) }}#pages">{{ 'Next'|t('speedy') }}</a>{% endif %}
				</div>
			{% endif %}
		{% else %}
			<p class="zilch">{{ search ? 'No cached pages match.'|t('speedy') : 'No pages cached yet. They’re cached as visitors arrive.'|t('speedy') }}</p>
		{% endif %}
	</section>

	<section class="speedy-panel" id="speedy-panel-clears" role="tabpanel" aria-labelledby="speedy-tab-clears">
		<h2 class="speedy-panel__title">{{ 'Recent clears'|t('speedy') }}</h2>
		{% if log|length %}
			<div class="speedy-collapsible">
			<table class="data fullwidth">
				<thead><tr><th scope="col">{{ 'When'|t('speedy') }}</th><th scope="col">{{ 'Why'|t('speedy') }}</th><th scope="col">{{ 'Pages'|t('speedy') }}</th></tr></thead>
				<tbody>
					{% for entry in log %}
						<tr{{ loop.index > 10 ? ' class="speedy-extra"' }}>
							<td class="nowrap">{{ entry.time|datetime('short') }}</td>
							<td>
								{{ entry.reason }}
								{% if entry.urls|length %}
									<details><summary class="light">{{ 'Show URLs'|t('speedy') }}</summary><div class="speedy-urls">{% for url in entry.urls %}<div>{{ url }}</div>{% endfor %}</div></details>
								{% endif %}
							</td>
							<td>{{ entry.count }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			{{ speedyMacros.toggle(log|length, 10) }}
			</div>
		{% else %}
			<p class="zilch">{{ 'Nothing cleared yet.'|t('speedy') }}</p>
		{% endif %}
	</section>

	{% if settings.queryReport %}
	<section class="speedy-panel" id="speedy-panel-queries" role="tabpanel" aria-labelledby="speedy-tab-queries">
		<h2 class="speedy-panel__title">{{ 'Performance'|t('speedy') }}</h2>
		<h3>{{ 'Slowest pages'|t('speedy') }}</h3>
		<p>{{ 'How long pages took to build when Speedy last rebuilt them. Visitors get the cached copy, but slow pages delay rebuilds, and every visitor who isn’t sent a cached page, such as logged-in visitors, waits this long.'|t('speedy') }}</p>
		{% if slowest|length %}
			<table class="data fullwidth speedy-pages">
				<thead><tr>
					<th scope="col">{{ 'Page'|t('speedy') }}</th>
					<th scope="col">{{ 'Built in'|t('speedy') }}</th>
					<th scope="col">{{ 'Queries'|t('speedy') }}</th>
					<th scope="col">{{ 'Rebuilt'|t('speedy') }}</th>
				</tr></thead>
				<tbody>
					{% for row in slowest|slice(0, 10) %}
						<tr>
							<td><a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url|replace({ 'https://': '', 'http://': '' }) }}</a></td>
							<td><strong>{{ row.ms >= 1000 ? '{s} s'|t('speedy', { s: (row.ms / 1000)|number_format(1) }) : '{ms} ms'|t('speedy', { ms: row.ms|number }) }}</strong></td>
							<td>{{ row.queries|number }}</td>
							<td class="light">{{ row.time|datetime('short') }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p class="zilch">{{ 'No page rebuilt so far took more than half a second.'|t('speedy') }}</p>
		{% endif %}

		{% if broad|length %}
			<h3 id="broad">{{ 'Cleared by any change'|t('speedy') }}</h3>
			<p>{{ 'These pages list elements without choosing a section or group, so they’re cleared whenever any element of that type is saved, such as by an import. Narrow the query to clear them less often, for example with `.section(\'news\')`.'|t('speedy')|md(inlineOnly=true) }}</p>
			<div class="speedy-collapsible">
				<table class="data fullwidth speedy-pages">
					<thead><tr>
						<th scope="col">{{ 'Query'|t('speedy') }}</th>
						<th scope="col">{{ 'On'|t('speedy') }}</th>
					</tr></thead>
					<tbody>
						{% for place in broad %}
							<tr{% if loop.index > 10 %} class="speedy-extra"{% endif %}>
								<td>
									<div>{{ 'Any of: {type}'|t('speedy', { type: place.type }) }}</div>
									{{ speedyMacros.place(place.at, place.code ?? null) }}
								</td>
								<td>
									<details class="speedy-inline"><summary>{{ '{count, plural, =1{# page} other{# pages}}'|t('speedy', { count: place.pages|length }) }}</summary>
										<ul class="speedy-urls">
											{% for url in place.pages|slice(0, 50) %}<li><a href="{{ url }}" target="_blank" rel="noopener">{{ url|replace({ 'https://': '', 'http://': '' }) }}</a></li>{% endfor %}
											{% if place.pages|length > 50 %}<li>{{ 'and {count} more'|t('speedy', { count: place.pages|length - 50 }) }}</li>{% endif %}
										</ul>
									</details>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				{{ speedyMacros.toggle(broad|length, 10) }}
			</div>
		{% endif %}

		<h3>{{ 'Repeated queries'|t('speedy') }}</h3>
		<p>{{ 'Pages that run the same database query again and again, usually for each item in a loop (an N+1 query). Cached pages are still fast, but these slow down rebuilds and every visitor who isn’t sent a cached page, such as logged-in visitors. Checked whenever Speedy rebuilds a page.'|t('speedy') }}</p>
		{% if queries|length %}
			<div class="speedy-collapsible">
				<table class="data fullwidth speedy-pages">
					<thead><tr>
						<th scope="col">{{ 'Page'|t('speedy') }}</th>
						<th scope="col">{{ 'Queries'|t('speedy') }}</th>
						<th scope="col">{{ 'Repeated'|t('speedy') }}</th>
					</tr></thead>
					<tbody>
						{% for row in queries %}
							<tr{% if loop.index > 10 %} class="speedy-extra"{% endif %}>
								<td>
									<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url|replace({ 'https://': '', 'http://': '' }) }}</a>
									<div class="light smalltext">{{ 'Checked {time}'|t('speedy', { time: row.time|datetime('short') }) }}{{ row.ms ? ' · ' ~ 'built in {ms} ms'|t('speedy', { ms: row.ms|number }) }}</div>
								</td>
								<td>{{ row.queries|number }}</td>
								<td>
									<div class="speedy-collapsible">
										{% for repeat in row.repeated %}
											{{ speedyMacros.repeat(repeat, loop.index > 3) }}
										{% endfor %}
										{{ speedyMacros.toggle(row.repeated|length, 3, true) }}
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				{{ speedyMacros.toggle(queries|length, 10) }}
			</div>
		{% else %}
			<p class="zilch">{{ 'No repeated queries found in the pages rebuilt so far.'|t('speedy') }}</p>
		{% endif %}
	</section>
	{% endif %}

	<section class="speedy-panel" id="speedy-panel-setup" role="tabpanel" aria-labelledby="speedy-tab-setup">
		<h2 class="speedy-panel__title">{{ 'Setup'|t('speedy') }}</h2>
		<h3>{{ 'Serve pages without PHP'|t('speedy') }}</h3>
		{% if settings.storage == 'craftCache' %}
			<p>{{ 'Pages are kept in Craft’s cache, so they’re sent by PHP. Server rules only work with files.'|t('speedy') }}</p>
		{% else %}
			<p>{{ 'Cached pages work as they are. For the fastest pages, let the web server send them without starting PHP: add these rules, then check it works.'|t('speedy') }}</p>
			{% if not webPath %}<p class="warning with-icon">{{ 'The cache folder isn’t inside the web root, so the web server can’t serve it. Set cachePath to a folder in @webroot.'|t('speedy') }}</p>{% endif %}
			<details><summary>{{ 'Nginx'|t('speedy') }}</summary><pre class="speedy-code"><code>{{ nginx }}</code></pre></details>
			<details><summary>{{ 'Apache'|t('speedy') }}</summary><pre class="speedy-code"><code>{{ apache }}</code></pre></details>
			<form method="post" class="speedy-setup-action">
				{{ csrfInput() }}{{ actionInput('speedy/utility/check-server') }}
				<button type="submit" class="btn">{{ 'Check server serving'|t('speedy') }}</button>
			</form>
		{% endif %}
		<h3>{{ 'CSS and JavaScript'|t('speedy') }}</h3>
		<p>{{ 'Cached pages link to the CSS and JavaScript files they were built with. After a deploy that replaced them, check that they’re all still there.'|t('speedy') }}</p>
		<form method="post" class="speedy-setup-action">
			{{ csrfInput() }}{{ actionInput('speedy/utility/check-assets') }}{{ redirectInput('utilities/speedy#setup') }}
			<button type="submit" class="btn">{{ 'Check CSS and JavaScript'|t('speedy') }}</button>
		</form>

		{% if configured|length or cdnLast|length %}
			<h3>{{ 'CDN'|t('speedy') }}</h3>
			{% for cdn, last in cdnLast %}
				<p class="{{ last.error ? 'error' : 'light' }}">{{ cdnNames[cdn] ?? cdn }}: {{ last.result }} · {{ last.time|datetime('short') }}</p>
			{% endfor %}
			{% if 'cloudflare' in configured %}
				<p>{{ 'Cloudflare only keeps pages once a cache rule lets it. Set up adds two rules to your zone: one keeps the sites’ pages for as long as Speedy says, the other leaves out logged-in visitors, carts, forms and the control panel. Your other rules stay as they are. The token needs the permission Zone → Cache Rules → Edit.'|t('speedy') }}</p>
				{% if cloudflareRules %}<p class="light">{{ 'Set up for {hosts} · {time}'|t('speedy', { hosts: cloudflareRules.hosts|join(', '), time: cloudflareRules.time|datetime('short') }) }}</p>{% endif %}
			{% endif %}
			{% if configured|length %}
				<div class="speedy-actions">
					{% if 'cloudflare' in configured %}
						<form method="post">
							{{ csrfInput() }}{{ actionInput('speedy/utility/set-up-cloudflare') }}{{ redirectInput('utilities/speedy#setup') }}
							<button type="submit" class="btn submit">{{ cloudflareRules ? 'Update Cloudflare’s cache rules'|t('speedy') : 'Set up Cloudflare'|t('speedy') }}</button>
						</form>
					{% endif %}
					{% for cdn in configured %}
						<form method="post">
							{{ csrfInput() }}{{ actionInput('speedy/utility/test-cdn') }}{{ hiddenInput('cdn', cdn) }}
							<button type="submit" class="btn">{{ 'Test {cdn}'|t('speedy', { cdn: cdnNames[cdn] }) }}</button>
						</form>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}

		<h3>{{ 'Support report'|t('speedy') }}</h3>
		<p>{{ 'Versions, settings, checks and recent clears, to paste into a support email. Keys and tokens are only shown as “set”.'|t('speedy') }}</p>
		<div class="flex speedy-report-actions">
			<button type="button" class="btn" id="speedy-copy-report">{{ 'Copy support report'|t('speedy') }}</button>
			<a class="btn" id="speedy-email-report" href="mailto:support@suprim.com.au?subject={{ 'Speedy Cache support'|t('speedy')|url_encode }}" data-intro="{{ 'What happened, and on which page?'|t('speedy') }}" data-paste="{{ 'The support report is copied: paste it here.'|t('speedy') }}">{{ 'Email support'|t('speedy') }}</a>
			<span class="light" id="speedy-copied" hidden>{{ 'Copied.'|t('speedy') }}</span>
		</div>
		<details><summary class="light">{{ 'Show the report'|t('speedy') }}</summary><pre class="speedy-code" id="speedy-report">{{ report }}</pre></details>

		{% if state.lastExpire ?? false %}<p class="light">{{ 'Scheduled changes last checked {time}.'|t('speedy', { time: state.lastExpire|datetime('short') }) }}</p>{% endif %}
	</section>
</div>

{% css %}
.speedy-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 20px; }
.speedy-card { border: 1px solid var(--hairline-color, #e3e5e8); border-radius: 8px; padding: 14px 16px; }
.speedy-big { font-size: 22px; font-weight: 600; margin: 4px 0; }
.speedy-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 16px; }
.speedy-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 20px; }
.speedy-tool { display: flex; flex-direction: column; gap: 10px; }
.speedy-tool__title { font-size: 14px; font-weight: 600; margin: 0; }
.speedy-tool p { margin: 0; }
.speedy-tool__buttons { display: flex; flex-wrap: wrap; gap: 8px; }
.speedy-tool__row { display: flex; flex-wrap: wrap; gap: 8px; }
.speedy-tool__row .text, .speedy-tool__row .select, .speedy-tool__row .multiselect { flex: 1 1 160px; min-width: 0; }
.speedy-tool__row select { width: 100%; }
.speedy-tool__row .btn { flex-shrink: 0; }
.speedy-urls { font-size: 12px; color: var(--light-text-color, #606d7b); margin-top: 4px; }
.speedy-code { background: #f3f7fc; padding: 12px 14px; border-radius: 6px; font-size: 12px; overflow-x: auto; white-space: pre; }
.speedy-checks { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 6px; }
.speedy-check { display: flex; gap: 10px; align-items: baseline; padding: 10px 14px; border-radius: 6px; background: var(--gray-050, #f3f7fc); }
.speedy-check__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--blue-500, #3b82f6); transform: translateY(-1px); }
.speedy-check--error .speedy-check__dot { background: var(--red-500, #ef4444); }
.speedy-check--warning .speedy-check__dot { background: var(--yellow-500, #eab308); }
.speedy-check--ok .speedy-check__dot { background: var(--green-500, #22c55e); }
.speedy-pagecheck__result { margin: -8px 0 20px; }
.speedy-pagecheck__result p { margin: 0 0 4px; }
.speedy-pagecheck__result p:last-child { margin-bottom: 0; }
.speedy-search { gap: 8px; margin-bottom: 12px; }
.speedy-deps { margin: 6px 0 0; padding-left: 18px; list-style: disc; font-size: 12px; }
.speedy-pages td { vertical-align: top; }
.speedy-pager { gap: 10px; margin-top: 12px; }
.speedy-report-actions { gap: 10px; margin-bottom: 8px; }
.speedy-repeat + .speedy-repeat { margin-top: 8px; }
.speedy-repeat .speedy-code { white-space: pre-wrap; margin-top: 4px; }
.speedy-collapsible:not(.is-open) > .speedy-extra, .speedy-collapsible:not(.is-open) > table > tbody > .speedy-extra { display: none; }
.speedy-toggle { margin-top: 8px; }
.speedy-link { padding: 0; border: 0; background: none; color: var(--link-color, #3253c8); cursor: pointer; font-size: inherit; }
.speedy-link:hover { text-decoration: underline; }
.speedy-repeat + .speedy-link { margin-top: 4px; }
.speedy-place > summary, .speedy-inline > summary { cursor: pointer; color: var(--link-color, #3253c8); }
.speedy-place > summary { color: var(--light-text-color, #606d7b); }
.speedy-place > summary:hover, .speedy-inline > summary:hover { text-decoration: underline; }
.speedy-inline { display: inline; }
.speedy-inline > summary { display: inline; list-style: none; }
.speedy-inline > summary::-webkit-details-marker { display: none; }
.speedy-inline[open] { display: block; }
.speedy-urls { margin: 4px 0 0; padding: 0; list-style: none; }
.speedy-repeat .speedy-lines, .speedy-lines { display: grid; grid-template-columns: max-content max-content; column-gap: 12px; white-space: pre; overflow-x: auto; max-width: 100%; }
.speedy-lines .ln { color: #8a96a3; text-align: right; user-select: none; }
.speedy-lines .hit { background: #fff3c4; }
.speedy-place[open], .speedy-inline[open] { max-width: 100%; }
.speedy-tabs { display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; gap: 4px; border-bottom: 1px solid var(--hairline-color, #e3e5e8); margin: 8px 0 20px; }
.speedy-tabs a { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 10px 14px; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--light-text-color, #606d7b); text-decoration: none; font-weight: 500; }
.speedy-tabs a:hover { color: var(--text-color, #3f4d5a); }
.speedy-tabs a[aria-selected="true"] { color: var(--text-color, #1f2937); border-bottom-color: var(--blue-500, #3b82f6); }
.speedy-tabs a:focus-visible { outline: 2px solid var(--blue-500, #3b82f6); outline-offset: -2px; border-radius: 4px; }
.speedy-badge { font-size: 11px; line-height: 1; padding: 3px 6px; border-radius: 10px; background: var(--gray-100, #e5e7eb); color: var(--text-color, #3f4d5a); }
.speedy-badge--alert { background: var(--yellow-100, #fef3c7); color: #92400e; }
.speedy-panel { margin-bottom: 28px; }
.speedy-panel h3 { margin-top: 24px; }
.speedy-panel h3:first-of-type { margin-top: 0; }
.speedy-setup-action { margin-top: 12px; }
.speedy-tabbed .speedy-panel__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.speedy-coverage-actions { gap: 12px; flex-wrap: wrap; margin: 12px 0 8px; }
{% endcss %}

{% js %}
// “Show N more” and “Show less”, under lists that hide all but their first items.
document.addEventListener('click', function(e) {
	var button = e.target.closest('.speedy-toggle');
	if (!button) return;
	var list = button.closest('.speedy-collapsible');
	var open = list.classList.toggle('is-open');
	button.setAttribute('aria-expanded', open ? 'true' : 'false');
	button.textContent = open ? button.dataset.less : button.dataset.more;
});

document.getElementById('speedy-email-report')?.addEventListener('click', function (e) {
	// The report goes in the email when it fits in a mailto link; otherwise it's copied to paste in.
	var link = this, report = document.getElementById('speedy-report').textContent;
	var body = link.dataset.intro + '\n\n\n--- Speedy Cache report ---\n' + report;
	var href = link.getAttribute('href').split('&body=')[0];
	if ((href + '&body=' + encodeURIComponent(body)).length > 1900) {
		navigator.clipboard?.writeText(report).catch(function () {});
		body = link.dataset.intro + '\n\n\n' + link.dataset.paste + '\n';
	}
	link.setAttribute('href', href + '&body=' + encodeURIComponent(body));
});
document.getElementById('speedy-copy-report')?.addEventListener('click', function () {
	navigator.clipboard.writeText(document.getElementById('speedy-report').textContent).then(function () {
		document.getElementById('speedy-copied').hidden = false;
	}).catch(function () {
		// Without clipboard access, open the report so it can be selected.
		document.getElementById('speedy-report').closest('details').open = true;
	});
});
(function () {
	var root = document.querySelector('.speedy');
	var nav = root && root.querySelector('.speedy-tabs');
	if (!nav) { return; }
	var tabs = Array.prototype.slice.call(nav.querySelectorAll('[role="tab"]'));
	var ids = tabs.map(function (t) { return t.getAttribute('href').slice(1); });
	function show(id, focus) {
		if (ids.indexOf(id) === -1) { id = ids[0]; }
		tabs.forEach(function (t, i) {
			var on = ids[i] === id;
			t.setAttribute('aria-selected', on ? 'true' : 'false');
			t.tabIndex = on ? 0 : -1;
			document.getElementById('speedy-panel-' + ids[i]).hidden = !on;
			if (on && focus) { t.focus(); }
		});
	}
	root.classList.add('speedy-tabbed');
	nav.hidden = false;
	nav.addEventListener('click', function (e) {
		var tab = e.target.closest('[role="tab"]');
		if (!tab) { return; }
		e.preventDefault();
		var id = tab.getAttribute('href').slice(1);
		history.replaceState(null, '', '#' + id);
		show(id, false);
	});
	nav.addEventListener('keydown', function (e) {
		var i = tabs.indexOf(document.activeElement);
		if (i === -1 || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) { return; }
		e.preventDefault();
		var next = ids[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
		history.replaceState(null, '', '#' + next);
		show(next, true);
	});
	// Links to a tab elsewhere on the page, such as a tip.
	root.addEventListener('click', function (e) {
		var link = e.target.closest('a[href^="#"]');
		if (!link || nav.contains(link)) { return; }
		var id = link.getAttribute('href').slice(1);
		if (ids.indexOf(id) !== -1) { e.preventDefault(); history.replaceState(null, '', '#' + id); show(id, false); nav.scrollIntoView({ block: 'start' }); }
	});
	window.addEventListener('hashchange', function () { show(location.hash.slice(1), false); });
	// Craft takes the hash off the address as the page loads, keeping it in LOCATION_HASH.
	var first = window.LOCATION_HASH || location.hash.slice(1);
	if (ids.indexOf(first) !== -1) { history.replaceState(null, '', '#' + first); }
	show(first, false);
})();
{% endjs %}

{% macro lines(code) %}
	<pre class="speedy-code speedy-lines">
		{%- for n, text in code.lines -%}
			<span class="ln{{ n == code.line ? ' hit' }}">{{ n }}</span><span class="{{ n == code.line ? 'hit' }}">{{ text ?: ' ' }}</span>
		{%- endfor -%}
	</pre>
{% endmacro %}

{# Where a query ran, such as `news/_index, line 12`: click it to see the code there. #}
{% macro place(at, code) %}
	{% import _self as speedyMacros %}
	{%- if code -%}
		<details class="speedy-place"><summary>{{ at }}</summary>{{ speedyMacros.lines(code) }}</details>
	{%- elseif at -%}
		<div class="light">{{ at }}</div>
	{%- endif -%}
{% endmacro %}

{% macro repeat(repeat, extra) %}
	{% import _self as speedyMacros %}
	<div class="speedy-repeat{{ extra ? ' speedy-extra' }}">
		<strong>{{ '{count}×'|t('speedy', { count: repeat.count }) }}</strong> {{ repeat.tip }}
		{%- if repeat.code ?? null %} <details class="speedy-inline"><summary>{{ 'Code'|t('speedy') }}</summary>{{ speedyMacros.lines(repeat.code) }}</details>{% endif %}
	</div>
{% endmacro %}

{# “Show N more” under a list whose items after the first few are hidden, becoming “Show less” once open. #}
{% macro toggle(total, shown, link = false) %}
	{%- if total > shown -%}
		{% set more = 'Show {count} more'|t('speedy', { count: total - shown }) %}
		<button type="button" class="{{ link ? 'speedy-link' : 'btn small' }} speedy-toggle" aria-expanded="false" data-more="{{ more }}" data-less="{{ 'Show less'|t('speedy') }}">{{ more }}</button>
	{%- endif -%}
{% endmacro %}
