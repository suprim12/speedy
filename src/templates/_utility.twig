<div class="speedy">
	<div class="speedy-grid">
		<div class="speedy-card">
			<p class="light">{{ 'Caching'|t('speedy') }}</p>
			<p class="speedy-big">{{ settings.isEnabled() ? 'On'|t('speedy') : 'Off'|t('speedy') }}</p>
		</div>
		<div class="speedy-card">
			<p class="light">{{ 'Pages cached'|t('speedy') }}</p>
			<p class="speedy-big">{{ stats.pages|number }}</p>
			<p class="light">{{ (stats.bytes / 1048576)|number_format(1) }} MB</p>
		</div>
		<div class="speedy-card">
			<p class="light">{{ 'CDN'|t('speedy') }}</p>
			<p class="speedy-big">{{ detected ? cdnNames[detected] : 'None seen'|t('speedy') }}</p>
			<p class="light">
				{% if configured|length %}{{ 'Clearing: {cdns}'|t('speedy', { cdns: configured|map(c => cdnNames[c])|join(', ') }) }}
				{% elseif detected %}{{ 'Add details in Settings to let it cache pages too.'|t('speedy') }}
				{% else %}{{ 'Optional'|t('speedy') }}{% endif %}
			</p>
		</div>
		{% if 'cloudfront' in configured %}
			<div class="speedy-card">
				<p class="light">{{ 'CloudFront paths this month'|t('speedy') }}</p>
				<p class="speedy-big">{{ cloudfront.paths|number }}</p>
				<p class="light">{{ 'The first 1,000 each month are free.'|t('speedy') }}</p>
			</div>
		{% endif %}
	</div>

	{% if checks|length %}
		<ul class="speedy-checks">
			{% for check in checks %}
				<li class="speedy-check speedy-check--{{ check.level }}">
					<span class="speedy-check__dot" aria-hidden="true"></span>
					<span><strong>{{ { error: 'Problem'|t('speedy'), warning: 'Check'|t('speedy'), hint: 'Tip'|t('speedy') }[check.level] }}</strong> {{ check.message|md(inlineOnly=true) }}</span>
				</li>
			{% endfor %}
		</ul>
	{% endif %}

	<div class="speedy-actions">
		<form method="post">
			{{ csrfInput() }}{{ actionInput('speedy/utility/clear-all') }}
			<button type="submit" class="btn submit">{{ 'Clear all pages'|t('speedy') }}</button>
		</form>
		<form method="post">
			{{ csrfInput() }}{{ actionInput('speedy/utility/rebuild-all') }}
			<button type="submit" class="btn" title="{{ 'Visitors keep getting the old copies until the new ones are ready.'|t('speedy') }}">{{ 'Rebuild all pages'|t('speedy') }}</button>
		</form>
		<form method="post" class="flex">
			{{ csrfInput() }}{{ actionInput('speedy/utility/clear-url') }}
			<input type="url" name="url" class="text" placeholder="https://…" aria-label="{{ 'URL to clear'|t('speedy') }}" required style="width: 320px;">
			<button type="submit" class="btn">{{ 'Clear URL'|t('speedy') }}</button>
		</form>
		{% if settings.warm %}
			<form method="post">
				{{ csrfInput() }}{{ actionInput('speedy/utility/warm') }}
				<button type="submit" class="btn">{{ 'Warm pages'|t('speedy') }}</button>
			</form>
		{% endif %}
	</div>

	{% set tabs = {
		pages: 'Pages'|t('speedy'),
		clears: 'Recent clears'|t('speedy'),
	}|merge(settings.queryReport ? { queries: 'Repeated queries'|t('speedy') } : {})|merge({
		setup: 'Setup'|t('speedy'),
	}) %}
	{% set counts = { pages: stats.pages, queries: queries|length } %}
	<nav class="speedy-tabs" role="tablist" aria-label="{{ 'Speedy Cache'|t('speedy') }}" hidden>
		{% for id, label in tabs %}
			<a href="#{{ id }}" role="tab" id="speedy-tab-{{ id }}" aria-controls="speedy-panel-{{ id }}" aria-selected="false" tabindex="-1">
				{{ label }}{% if counts[id] ?? 0 %} <span class="speedy-badge{{ id == 'queries' ? ' speedy-badge--alert' }}">{{ counts[id]|number }}</span>{% endif %}
			</a>
		{% endfor %}
	</nav>

	<section class="speedy-panel" id="speedy-panel-pages" role="tabpanel" aria-labelledby="speedy-tab-pages">
		<h2 class="speedy-panel__title">{{ 'Cached pages'|t('speedy') }}</h2>
		<form method="get" class="flex speedy-search" action="{{ url('utilities/speedy') }}#pages">
			<input type="search" name="speedySearch" value="{{ search }}" class="text" placeholder="{{ 'Search URLs'|t('speedy') }}" aria-label="{{ 'Search URLs'|t('speedy') }}" style="width: 320px;">
			<button type="submit" class="btn">{{ 'Search'|t('speedy') }}</button>
			<span class="light">{{ '{count, plural, =1{# page} other{# pages}}'|t('speedy', { count: list.total }) }}</span>
		</form>
		{% if list.pages|length %}
			<table class="data fullwidth speedy-pages">
				<thead><tr>
					<th scope="col">{{ 'URL'|t('speedy') }}</th>
					<th scope="col">{{ 'Cached'|t('speedy') }}</th>
					<th scope="col">{{ 'Clears when these change'|t('speedy') }}</th>
					<th scope="col"><span class="visually-hidden">{{ 'Actions'|t('speedy') }}</span></th>
				</tr></thead>
				<tbody>
					{% for row in list.pages %}
						{% set deps = row.deps %}
						<tr>
							<td><a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url|replace({ 'https://': '', 'http://': '' }) }}</a></td>
							<td class="nowrap">
								{{ row.created ? row.created|datetime('short') }}
								{% if row.expires %}<div class="light smalltext">{{ 'Rebuilt {time}'|t('speedy', { time: row.expires|datetime('short') }) }}</div>{% endif %}
							</td>
							<td>
								{% if deps|length %}
									<details><summary class="light">{{ '{count, plural, =1{# thing} other{# things}}'|t('speedy', { count: deps|length }) }}</summary><ul class="speedy-deps">{% for dep in deps %}<li>{{ dep|raw }}</li>{% endfor %}</ul></details>
								{% else %}
									<span class="light">{{ 'Only a full clear'|t('speedy') }}</span>
								{% endif %}
							</td>
							<td class="thin">
								<form method="post">
									{{ csrfInput() }}{{ actionInput('speedy/utility/clear-url') }}{{ hiddenInput('url', row.url) }}
									<button type="submit" class="btn small">{{ 'Clear'|t('speedy') }}</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			{% set pages = (list.total / perPage)|round(0, 'ceil') %}
			{% if pages > 1 %}
				<div class="flex speedy-pager">
					{% if page > 1 %}<a class="btn small" href="{{ url('utilities/speedy', { speedySearch: search, speedyPage: page - 1 }) }}#pages">{{ 'Previous'|t('speedy') }}</a>{% endif %}
					<span class="light">{{ 'Page {page} of {pages}'|t('speedy', { page: page, pages: pages }) }}</span>
					{% if page < pages %}<a class="btn small" href="{{ url('utilities/speedy', { speedySearch: search, speedyPage: page + 1 }) }}#pages">{{ 'Next'|t('speedy') }}</a>{% endif %}
				</div>
			{% endif %}
		{% else %}
			<p class="zilch">{{ search ? 'No cached pages match.'|t('speedy') : 'No pages cached yet. They’re cached as visitors arrive.'|t('speedy') }}</p>
		{% endif %}
	</section>

	<section class="speedy-panel" id="speedy-panel-clears" role="tabpanel" aria-labelledby="speedy-tab-clears">
		<h2 class="speedy-panel__title">{{ 'Recent clears'|t('speedy') }}</h2>
		{% if log|length %}
			<table class="data fullwidth">
				<thead><tr><th scope="col">{{ 'When'|t('speedy') }}</th><th scope="col">{{ 'Why'|t('speedy') }}</th><th scope="col">{{ 'Pages'|t('speedy') }}</th></tr></thead>
				<tbody>
					{% for entry in log %}
						<tr{{ loop.index > 10 ? ' class="speedy-more" hidden' }}>
							<td class="nowrap">{{ entry.time|datetime('short') }}</td>
							<td>
								{{ entry.reason }}
								{% if entry.urls|length %}
									<details><summary class="light">{{ 'Show URLs'|t('speedy') }}</summary><div class="speedy-urls">{% for url in entry.urls %}<div>{{ url }}</div>{% endfor %}</div></details>
								{% endif %}
							</td>
							<td>{{ entry.count }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			{% if log|length > 10 %}
				<button type="button" class="btn small speedy-show-more">{{ 'Show {count} more'|t('speedy', { count: log|length - 10 }) }}</button>
			{% endif %}
		{% else %}
			<p class="zilch">{{ 'Nothing cleared yet.'|t('speedy') }}</p>
		{% endif %}
	</section>

	{% if settings.queryReport %}
	<section class="speedy-panel" id="speedy-panel-queries" role="tabpanel" aria-labelledby="speedy-tab-queries">
		<h2 class="speedy-panel__title">{{ 'Repeated queries'|t('speedy') }}</h2>
		<p>{{ 'Pages that run the same database query again and again, usually for each item in a loop (an N+1 query). Cached pages are still fast, but these slow down rebuilds and every visitor who isn’t sent a cached page, such as logged-in visitors. Checked whenever Speedy rebuilds a page.'|t('speedy') }}</p>
		{% if queries|length %}
			<table class="data fullwidth speedy-pages">
				<thead><tr>
					<th scope="col">{{ 'Page'|t('speedy') }}</th>
					<th scope="col">{{ 'Queries'|t('speedy') }}</th>
					<th scope="col">{{ 'Repeated'|t('speedy') }}</th>
				</tr></thead>
				<tbody>
					{% for row in queries %}
						<tr>
							<td>
								<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url|replace({ 'https://': '', 'http://': '' }) }}</a>
								<div class="light smalltext">{{ 'Checked {time}'|t('speedy', { time: row.time|datetime('short') }) }}{{ row.ms ? ' · ' ~ 'built in {ms} ms'|t('speedy', { ms: row.ms|number }) }}</div>
							</td>
							<td>{{ row.queries|number }}</td>
							<td>
								{% for repeat in row.repeated %}
									<div class="speedy-repeat">
										<strong>{{ '{count}×'|t('speedy', { count: repeat.count }) }}</strong> {{ repeat.tip }}
										<details><summary class="light">{{ 'Show the query'|t('speedy') }}</summary><pre class="speedy-code">{{ repeat.sql }}</pre></details>
									</div>
								{% endfor %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p class="zilch">{{ 'No repeated queries found in the pages rebuilt so far.'|t('speedy') }}</p>
		{% endif %}
	</section>
	{% endif %}

	<section class="speedy-panel" id="speedy-panel-setup" role="tabpanel" aria-labelledby="speedy-tab-setup">
		<h2 class="speedy-panel__title">{{ 'Setup'|t('speedy') }}</h2>
		<h3>{{ 'Serve pages without PHP'|t('speedy') }}</h3>
		{% if settings.storage == 'craftCache' %}
			<p>{{ 'Pages are kept in Craft’s cache, so they’re sent by PHP. Server rules only work with files.'|t('speedy') }}</p>
		{% else %}
			<p>{{ 'Cached pages work as they are. For the fastest pages, let the web server send them without starting PHP: add these rules, then check it works.'|t('speedy') }}</p>
			{% if not webPath %}<p class="warning with-icon">{{ 'The cache folder isn’t inside the web root, so the web server can’t serve it. Set cachePath to a folder in @webroot.'|t('speedy') }}</p>{% endif %}
			<details><summary>{{ 'Nginx'|t('speedy') }}</summary><pre class="speedy-code"><code>{{ nginx }}</code></pre></details>
			<details><summary>{{ 'Apache'|t('speedy') }}</summary><pre class="speedy-code"><code>{{ apache }}</code></pre></details>
			<form method="post" class="speedy-setup-action">
				{{ csrfInput() }}{{ actionInput('speedy/utility/check-server') }}
				<button type="submit" class="btn">{{ 'Check server serving'|t('speedy') }}</button>
			</form>
		{% endif %}

		{% if configured|length or cdnLast|length %}
			<h3>{{ 'CDN'|t('speedy') }}</h3>
			{% for cdn, last in cdnLast %}
				<p class="{{ last.error ? 'error' : 'light' }}">{{ cdnNames[cdn] ?? cdn }}: {{ last.result }} · {{ last.time|datetime('short') }}</p>
			{% endfor %}
			{% if configured|length %}
				<div class="speedy-actions">
					{% for cdn in configured %}
						<form method="post">
							{{ csrfInput() }}{{ actionInput('speedy/utility/test-cdn') }}{{ hiddenInput('cdn', cdn) }}
							<button type="submit" class="btn">{{ 'Test {cdn}'|t('speedy', { cdn: cdnNames[cdn] }) }}</button>
						</form>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}

		<h3>{{ 'Support report'|t('speedy') }}</h3>
		<p>{{ 'Versions, settings, checks and recent clears, to paste into a support email. Keys and tokens are only shown as “set”.'|t('speedy') }}</p>
		<div class="flex speedy-report-actions">
			<button type="button" class="btn" id="speedy-copy-report">{{ 'Copy support report'|t('speedy') }}</button>
			<span class="light" id="speedy-copied" hidden>{{ 'Copied.'|t('speedy') }}</span>
		</div>
		<details><summary class="light">{{ 'Show the report'|t('speedy') }}</summary><pre class="speedy-code" id="speedy-report">{{ report }}</pre></details>

		{% if state.lastExpire ?? false %}<p class="light">{{ 'Scheduled changes last checked {time}.'|t('speedy', { time: state.lastExpire|datetime('short') }) }}</p>{% endif %}
	</section>
</div>

{% css %}
.speedy-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }
.speedy-card { border: 1px solid var(--hairline-color, #e3e5e8); border-radius: 8px; padding: 14px 16px; }
.speedy-big { font-size: 22px; font-weight: 600; margin: 4px 0; }
.speedy-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 16px; }
.speedy-actions .flex { gap: 8px; }
.speedy-urls { font-size: 12px; color: var(--light-text-color, #606d7b); margin-top: 4px; }
.speedy-code { background: #f3f7fc; padding: 12px 14px; border-radius: 6px; font-size: 12px; overflow-x: auto; white-space: pre; }
.speedy-checks { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 6px; }
.speedy-check { display: flex; gap: 10px; align-items: baseline; padding: 10px 14px; border-radius: 6px; background: var(--gray-050, #f3f7fc); }
.speedy-check__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--blue-500, #3b82f6); transform: translateY(-1px); }
.speedy-check--error .speedy-check__dot { background: var(--red-500, #ef4444); }
.speedy-check--warning .speedy-check__dot { background: var(--yellow-500, #eab308); }
.speedy-search { gap: 8px; margin-bottom: 12px; }
.speedy-deps { margin: 6px 0 0; padding-left: 18px; list-style: disc; font-size: 12px; }
.speedy-pages td { vertical-align: top; }
.speedy-pager { gap: 10px; margin-top: 12px; }
.speedy-report-actions { gap: 10px; margin-bottom: 8px; }
.speedy-repeat + .speedy-repeat { margin-top: 8px; }
.speedy-repeat .speedy-code { white-space: pre-wrap; margin-top: 4px; }
.speedy-tabs { display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; gap: 4px; border-bottom: 1px solid var(--hairline-color, #e3e5e8); margin: 8px 0 20px; }
.speedy-tabs a { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 10px 14px; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--light-text-color, #606d7b); text-decoration: none; font-weight: 500; }
.speedy-tabs a:hover { color: var(--text-color, #3f4d5a); }
.speedy-tabs a[aria-selected="true"] { color: var(--text-color, #1f2937); border-bottom-color: var(--blue-500, #3b82f6); }
.speedy-tabs a:focus-visible { outline: 2px solid var(--blue-500, #3b82f6); outline-offset: -2px; border-radius: 4px; }
.speedy-badge { font-size: 11px; line-height: 1; padding: 3px 6px; border-radius: 10px; background: var(--gray-100, #e5e7eb); color: var(--text-color, #3f4d5a); }
.speedy-badge--alert { background: var(--yellow-100, #fef3c7); color: #92400e; }
.speedy-panel { margin-bottom: 28px; }
.speedy-panel h3 { margin-top: 24px; }
.speedy-panel h3:first-of-type { margin-top: 0; }
.speedy-setup-action { margin-top: 12px; }
.speedy-tabbed .speedy-panel__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.speedy-show-more { margin-top: 10px; }
{% endcss %}

{% js %}
document.getElementById('speedy-copy-report')?.addEventListener('click', function () {
	navigator.clipboard.writeText(document.getElementById('speedy-report').textContent).then(function () {
		document.getElementById('speedy-copied').hidden = false;
	});
});
(function () {
	var root = document.querySelector('.speedy');
	var nav = root && root.querySelector('.speedy-tabs');
	if (!nav) { return; }
	var tabs = Array.prototype.slice.call(nav.querySelectorAll('[role="tab"]'));
	var ids = tabs.map(function (t) { return t.getAttribute('href').slice(1); });
	function show(id, focus) {
		if (ids.indexOf(id) === -1) { id = ids[0]; }
		tabs.forEach(function (t, i) {
			var on = ids[i] === id;
			t.setAttribute('aria-selected', on ? 'true' : 'false');
			t.tabIndex = on ? 0 : -1;
			document.getElementById('speedy-panel-' + ids[i]).hidden = !on;
			if (on && focus) { t.focus(); }
		});
	}
	root.classList.add('speedy-tabbed');
	nav.hidden = false;
	nav.addEventListener('click', function (e) {
		var tab = e.target.closest('[role="tab"]');
		if (!tab) { return; }
		e.preventDefault();
		var id = tab.getAttribute('href').slice(1);
		history.replaceState(null, '', '#' + id);
		show(id, false);
	});
	nav.addEventListener('keydown', function (e) {
		var i = tabs.indexOf(document.activeElement);
		if (i === -1 || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) { return; }
		e.preventDefault();
		var next = ids[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
		history.replaceState(null, '', '#' + next);
		show(next, true);
	});
	// Links to a tab elsewhere on the page, such as a tip.
	root.addEventListener('click', function (e) {
		var link = e.target.closest('a[href^="#"]');
		if (!link || nav.contains(link)) { return; }
		var id = link.getAttribute('href').slice(1);
		if (ids.indexOf(id) !== -1) { e.preventDefault(); history.replaceState(null, '', '#' + id); show(id, false); nav.scrollIntoView({ block: 'start' }); }
	});
	window.addEventListener('hashchange', function () { show(location.hash.slice(1), false); });
	// Craft takes the hash off the address as the page loads, keeping it in LOCATION_HASH.
	var first = window.LOCATION_HASH || location.hash.slice(1);
	if (ids.indexOf(first) !== -1) { history.replaceState(null, '', '#' + first); }
	show(first, false);

	var more = root.querySelector('.speedy-show-more');
	more && more.addEventListener('click', function () {
		root.querySelectorAll('.speedy-more').forEach(function (row) { row.hidden = false; });
		more.remove();
	});
})();
{% endjs %}
